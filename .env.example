# ── Database (used by the `db` compose service) ─────────────────────────────
POSTGRES_USER=plannerr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plannerr

# Port the web app is exposed on (docker compose).
WEB_PORT=8080

# ── Server ──────────────────────────────────────────────────────────────────
# Connection string for the server. Locally, point at localhost;
# docker compose rewrites the host to `db`.
DATABASE_URL=postgresql+psycopg://plannerr:change-me@localhost:5432/plannerr

# Secret pepper mixed into password hashing. Generate with:
#   uv run --project server python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required. Never commit a real value.
PASSWORD_PEPPER=

# Set to true when serving over HTTPS (docker compose sets this).
COOKIE_SECURE=false

# ── Push notifications (Web Push / VAPID) ──────────────────────────────────
# Generate a keypair with:
#   uv run --project server python -m app.vapid_keys
# and paste the two values below. Without these the notifications UI is disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services (must be a mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com

# ── LLM daily summary (OpenAI-compatible) ──────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint works: LiteLLM proxy
# (http://host:4000/v1), Ollama (http://host:11434/v1), OpenAI, OpenRouter…
# Leave LLM_BASE_URL empty to use the built-in deterministic fallback summary
# (the test button still works). LLM_API_KEY is optional (Ollama/keyless
# LiteLLM need no key).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
