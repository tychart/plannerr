# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# npm lockfile is legacy — the repo auto-updates deps at image build time
# (see Containerfile), so no npm lock is committed either.
package-lock.json
# bun.lock is disposable: generated locally on every `bun install`, never
# committed, never copied into the image. Range updates are tracked by the ^
# bounds in package.json.
bun.lock

