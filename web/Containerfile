# syntax=docker/dockerfile:1
# Plannerr web app — multi-stage: build with Bun, serve with nginx.
# bun is the primary package manager: bun.lock is the lockfile of record
# (keep it committed; never add package-lock.json back). `bun run build` runs
# the same `tsc -b && vite build` script npm users get locally.
FROM docker.io/oven/bun:1-alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build

FROM nginx:alpine
# The stock nginx image symlinks its logs to /dev/std{out,err}. Under rootless
# Podman a container process can't re-open those, so nginx would exit with
# "Permission denied". Removing the symlinks makes nginx log to plain files
# under /var/log/nginx (view with: podman exec plannerr-web-1 tail …/access.log).
RUN rm -f /var/log/nginx/access.log /var/log/nginx/error.log
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
