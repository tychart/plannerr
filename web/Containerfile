# syntax=docker/dockerfile:1
# Plannerr web app — multi-stage: build with Bun, serve with nginx.
# Dependency policy: auto-update at build. bun.lock is disposable and never
# committed nor copied into the image (see web/.dockerignore); each build
# resolves the newest packages matching the ^ ranges in package.json.
# To force a true refresh (bypass layer cache + refresh the base image):
#   podman-compose build --pull=newer --no-cache web
# (docker: docker compose build --no-cache web)
FROM docker.io/oven/bun:1-alpine AS build
WORKDIR /app

COPY package.json ./
RUN bun install

COPY . .
RUN bun run build

FROM nginx:alpine
# The stock nginx image symlinks its logs to /dev/std{out,err}. Under rootless
# Podman a container process can't re-open those, so nginx would exit with
# "Permission denied". Removing the symlinks makes nginx log to plain files
# under /var/log/nginx (view with: podman exec plannerr-web-1 tail …/access.log).
RUN rm -f /var/log/nginx/access.log /var/log/nginx/error.log
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
